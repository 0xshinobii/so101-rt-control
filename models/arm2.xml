<!--
  2-link planar arm, swinging in the x-z plane so gravity acts on it.
  Deliberately simple: two hinge joints, two torque motors, one end-effector
  site. This is the fixed test bed for every controller phase.
-->
<mujoco model="arm2">
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <worldbody>
    <light pos="0 -1 2" dir="0 1 -2"/>

    <!-- Link 1: rotates about the world y-axis at the base. -->
    <body name="link1" pos="0 0 1.2">
      <joint name="j1" type="hinge" axis="0 1 0"/>
      <geom name="g1" type="capsule" fromto="0 0 0 0.5 0 0" size="0.04" mass="1.0"/>

      <!-- Link 2: hinged at the tip of link 1. -->
      <body name="link2" pos="0.5 0 0">
        <joint name="j2" type="hinge" axis="0 1 0"/>
        <geom name="g2" type="capsule" fromto="0 0 0 0.4 0 0" size="0.035" mass="0.6"/>

        <!-- End-effector reference point (tip of link 2). -->
        <site name="ee" pos="0.4 0 0" size="0.02"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Direct torque control at each joint; ranges model real motor limits. -->
    <motor joint="j1" ctrlrange="-150 150"/>
    <motor joint="j2" ctrlrange="-80 80"/>
  </actuator>
</mujoco>
