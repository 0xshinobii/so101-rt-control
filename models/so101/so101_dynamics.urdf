<?xml version="1.0"?>
<!--
  Dynamics-only SO-101 description for Pinocchio.

  The link/joint inertials and transforms below mirror so101_torque.xml
  exactly. The upstream so101_new_calib.urdf remains vendored beside this file;
  this compact derivative removes visual geometry and aligns the rounded
  MuJoCo Menagerie transforms so the two engines model the same rigid body.
-->
<robot name="so101_dynamics">
  <link name="base_link">
    <inertial>
      <origin xyz="0.0137179 -0.0000519711 0.0334843" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="-0.000000459787" ixz="0.00000497151"
               iyy="0.000136117" iyz="0.0000000975275" izz="0.000130364"/>
    </inertial>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.0307604 -0.000017 -0.0252713" rpy="0 0 0"/>
      <mass value="0.100006"/>
      <inertia ixx="0.000083759" ixy="0.0000000755525" ixz="-0.00000116342"
               iyy="0.0000810403" iyz="0.000000154663" izz="0.0000239783"/>
    </inertial>
  </link>
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0388353 0 0.0624" rpy="3.141592653589793 0 -3.141592653589793"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.94" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.089847 -0.008382 0.018409" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="0.0000408002" ixy="-0.0000197819" ixz="-0.0000000403016"
               iyy="0.000147318" iyz="0.00000000897326" izz="0.000142487"/>
    </inertial>
  </link>
  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542"
            rpy="-1.570796326794897 -1.570796326794897 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.94" velocity="10" lower="-1.7453293" upper="1.7453293"/>
  </joint>

  <link name="lower_arm_link">
    <inertial>
      <origin xyz="-0.098070 0.0032438 0.018283" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="0.0000287438" ixy="0.00000741152" ixz="0.00000126409"
               iyy="0.000159844" iyz="-0.0000000490188" izz="0.00014529"/>
    </inertial>
  </link>
  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 0" rpy="0 0 1.570796326794897"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.94" velocity="10" lower="-1.69" upper="1.69"/>
  </joint>

  <link name="wrist_link">
    <inertial>
      <origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="0.0000368263" ixy="0.000000017893" ixz="-0.0000000528128"
               iyy="0.000025391" iyz="0.0000036412" izz="0.000021"/>
    </inertial>
  </link>
  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 0" rpy="0 0 -1.570796326794897"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.94" velocity="10" lower="-1.658063" upper="1.658063"/>
  </joint>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0.000214 0.000245 -0.025187" rpy="0 0 0"/>
      <mass value="0.087"/>
      <inertia ixx="0.0000275087" ixy="-0.000000335241" ixz="-0.0000057352"
               iyy="0.0000433657" iyz="-0.0000000517847" izz="0.0000345059"/>
    </inertial>
  </link>
  <joint name="wrist_roll" type="revolute">
    <origin xyz="0 -0.0611 0.0181"
            rpy="1.570796326794897 0.04867951485346193 3.141592653589793"/>
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.94" velocity="10" lower="-2.7438473" upper="2.7438473"/>
  </joint>

  <link name="moving_jaw_so101_v1_link">
    <inertial>
      <origin xyz="-0.001575 -0.0300244 0.0192755" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="0.00000661427" ixy="-0.000000319807" ixz="-0.00000000590717"
               iyy="0.00000189032" iyz="-0.000000109945" izz="0.00000528738"/>
    </inertial>
  </link>
  <joint name="gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.570796326794897 0 0"/>
    <parent link="gripper_link"/>
    <child link="moving_jaw_so101_v1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.94" velocity="10" lower="-0.174533" upper="1.7453292"/>
  </joint>

  <link name="camera_mount_link">
    <inertial>
      <origin xyz="-0.0009316021647151765 0.05015953175138088 -0.0354381548290492"
              rpy="-3.140375178332779 1.109991004370927 -1.560219428197043"/>
      <mass value="0.012"/>
      <inertia ixx="0.000004871996346461968" ixy="0" ixz="0"
               iyy="0.000003833764238074213" iyz="0"
               izz="0.00000117272829017776"/>
    </inertial>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_link"/>
    <child link="camera_mount_link"/>
  </joint>

  <link name="gripper_frame_link"/>
  <joint name="gripper_frame_joint" type="fixed">
    <origin xyz="0.012 -0.000218 -0.098127"
            rpy="0 1.570796326794897 0"/>
    <parent link="gripper_link"/>
    <child link="gripper_frame_link"/>
  </joint>
</robot>
